# Archive RPC for Robinhood Chain mainnet (chain id 4663).
#
# An archive endpoint is required: fork tests pin a block, and the public RPC
# (rpc.mainnet.chain.robinhood.com) keeps only ~10-25 minutes of state history —
# eth_getStorageAt beyond that returns "metadata is not found". The public RPC is
# also DNS-hijacked by some ISPs, and anvil cannot take curl's --resolve flag.
#
# Alchemy's free tier works: https://robinhood-mainnet.g.alchemy.com/v2/<KEY>
ROBINHOOD_RPC_URL=

# Deployment key. Unused until Phase 1 — leave empty for local work.
PRIVATE_KEY=
